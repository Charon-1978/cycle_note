<?xml version="1.0" encoding="utf-8"?>
<!-- 今日小组件布局（P3-3）。
     尺寸纪律：4x1 网格（180x60dp），两行文本，小屏不换行靠 ellipsize。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_today_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今日摄入 / 预算"
        android:textSize="12sp"
        android:textColor="#8A8A8E" />

    <TextView
        android:id="@+id/widget_intake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:ellipsize="end"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_budget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预算 "
            android:textSize="12sp"
            android:textColor="#8A8A8E" />

        <TextView
            android:id="@+id/widget_budget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textSize="12sp"
            android:textColor="#1C1C1E"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_weight_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="体重 "
            android:textSize="12sp"
            android:textColor="#8A8A8E" />

        <TextView
            android:id="@+id/widget_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未记录"
            android:textSize="12sp"
            android:textColor="#1C1C1E"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
